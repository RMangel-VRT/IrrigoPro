[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 6000

[[ports]]
localPort = 18522
externalPort = 3003

[[ports]]
localPort = 21025
externalPort = 3000

[[ports]]
localPort = 21209
externalPort = 3001

[[ports]]
localPort = 23333
externalPort = 3002

[[ports]]
localPort = 23334
externalPort = 5173

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
USE_DB_OAUTH_STATE = "1"
SENDGRID_FROM_EMAIL = "info@highplainsprop.com"
