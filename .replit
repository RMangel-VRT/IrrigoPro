modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "auth-middleware-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "company-id-backfill-migration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pdf-cover-header"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wc-customer-picker-filter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wc-in-flight-photos"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wet-check-zone-filter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "qb-invoice-ops"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wet-check-select-shape"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-reminders"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-ar-list"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-ar-ui"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-reminders-batch"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-batch-reminders-ui"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-ar-notes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-ar-notes-panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "storage-error-propagation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-row-expansion-reads"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-row-expansion-ui"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "nav-config-bookkeeper"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-draft-editor-line-items"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "work-order-labor-hours"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "work-order-deferred-items"

[[workflows.workflow]]
name = "auth-middleware-coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx --test --test-reporter=spec src/routes/auth-middleware-coverage.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "company-id-backfill-migration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx/esm --test --test-reporter=spec src/migrations/0004-company-id-backfill.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pdf-cover-header"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx --test --test-reporter=spec src/pdf-cover-header.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "wc-customer-picker-filter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/irrigopro exec vitest run src/pages/wet-checks/CustomerPickerPage.test.tsx"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "wc-in-flight-photos"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/irrigopro && npx vitest run src/pages/wet-checks-in-flight-photos.test.tsx"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "wet-check-zone-filter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx --test --test-reporter=spec src/wet-check-zone-filter.test.ts"

[workflows.workflow.metadata]
isValidation = true

